{
  "name": "silkgrain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SilkGrain \u2014 premium Central Asian food e-commerce platform (Houston, TX)",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "verify": "pnpm secret:scan && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm bundle:budget",
    "setup:services": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-setup.ps1",
    "lighthouse": "node scripts/lighthouse.mjs",
    "prepare": "husky",
    "test:coverage": "turbo run test:coverage",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "secret:scan:history": "node scripts/secret-scan.mjs --history"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.62.1",
    "@silkgrain/config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "prettier --write --ignore-unknown",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
