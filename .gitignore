# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
storybook-static/
*.tsbuildinfo

# turbo
.turbo/

# env — never commit real secrets
.env
.env.*
!.env.example
!.env.production.example

# uploads and generated media
uploads/
apps/api/uploads/

# database dumps and backups
*.sql
*.sql.gz
*.dump
backups/
# ...but not the migrations, which the rule above swallowed whole. `CLAUDE.md` says every
# migration is committed with the code that needs it, and for four migrations it was not: the
# journal and the snapshots were tracked while the statements they index were ignored, so a
# fresh clone had a manifest pointing at four files that did not exist. It could not migrate,
# could not reset, and could not run the API tests, which migrate before the first assertion.
!apps/api/drizzle/*.sql

# local portable dev services (mysql, redis, mailpit, minio)
.services/

# test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# editors / os
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# misc
.eslintcache
.cache/
tmp/
