# ======================================================================================
# SilkGrain - local development environment
#
# Copy to .env and adjust. .env is gitignored and must never be committed.
# Values below match what `pnpm setup:services` provisions under .services/.
# ======================================================================================

# --------------------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --------------------------------------------------------------------------------------
# API
# --------------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001

# Public origin of the storefront. Used for canonical URLs, sitemap, OG tags,
# password-reset links and payment redirects.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:5174

# Comma-separated CORS whitelist. Never use "*" - cookies are involved.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --------------------------------------------------------------------------------------
# Database
#
# Port 3307, not 3306: XAMPP's MariaDB owns 3306 on the dev machine and the project
# targets MySQL 8 to match production.
# --------------------------------------------------------------------------------------
DATABASE_URL=mysql://root:silkgrain_dev_only@127.0.0.1:3307/silkgrain
DATABASE_URL_TEST=mysql://root:silkgrain_dev_only@127.0.0.1:3307/silkgrain_test

# Connection pool. Keep below MySQL's max_connections divided by PM2 instance count.
DATABASE_POOL_SIZE=10

# --------------------------------------------------------------------------------------
# Redis (BullMQ queues + distributed rate limiting)
# --------------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --------------------------------------------------------------------------------------
# Auth
#
# Generate real secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Access and refresh secrets must differ, so a leaked access secret cannot mint refreshes.
# --------------------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie settings for the refresh token. Secure must be true in production.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --------------------------------------------------------------------------------------
# Stripe
#
# Test keys from https://dashboard.stripe.com/test/apikeys
# Webhook secret from `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
#
# The placeholders below are enough for development: everything except the two calls that
# reach Stripe's API works without an account, and the webhook suite signs its own events.
# --------------------------------------------------------------------------------------

# Decision D-51. `false` does not register the webhook route at all and makes the three keys
# below unnecessary - which is how a shop with no Stripe account deploys as a catalogue.
# Never run production with payments on and the placeholders still in place: verification is
# HMAC against a secret published in this repository. See .env.production.example.
PAYMENTS_ENABLED=true

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe Tax handles US sales tax. Disable only if the account has no tax registration yet.
STRIPE_TAX_ENABLED=true

# --------------------------------------------------------------------------------------
# PayPal
#
# Separate integration, not routed through Stripe: Stripe's PayPal support is limited
# for US merchants. Sandbox credentials from https://developer.paypal.com/dashboard/
# --------------------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me
PAYPAL_WEBHOOK_ID=replace_me
VITE_PAYPAL_CLIENT_ID=replace_me

# --------------------------------------------------------------------------------------
# Email
#
# Locally: Mailpit on 1025, inbox at http://localhost:8025 - nothing leaves the machine.
# Production: switch MAIL_TRANSPORT to the chosen provider (see QUESTIONS.md Q-41).
# --------------------------------------------------------------------------------------
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM_NAME=SilkGrain
MAIL_FROM_ADDRESS=orders@silkgrain.com
MAIL_REPLY_TO=hello@silkgrain.com
# Where wholesale enquiries and low-stock alerts are sent.
MAIL_OPS_ADDRESS=ops@silkgrain.com

# --------------------------------------------------------------------------------------
# Object storage (product images)
#
# Locally: MinIO, console at http://localhost:9001
# Production: any S3-compatible endpoint.
# --------------------------------------------------------------------------------------
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=silkgrain-media
S3_ACCESS_KEY_ID=silkgrain
S3_SECRET_ACCESS_KEY=silkgrain-dev-secret
# MinIO needs path-style addressing; most cloud providers do not.
S3_FORCE_PATH_STYLE=true
# Public base URL images are served from.
S3_PUBLIC_URL=http://127.0.0.1:9000/silkgrain-media

# --------------------------------------------------------------------------------------
# Commerce defaults
#
# These are seed values only. Shipping rates live in the database and are edited in the
# admin panel; changing them here after seeding has no effect.
# --------------------------------------------------------------------------------------
FREE_SHIPPING_THRESHOLD_CENTS=7500
DEFAULT_TAX_RATE_BASIS_POINTS=825
ORDER_NUMBER_PREFIX=SG

# --------------------------------------------------------------------------------------
# Observability
# --------------------------------------------------------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=
